# Entity: ecom_parameter

main: kit: entity: ecom_parameter: {

  alias: field: {}

  fields: [
    {
      name: "ecomPass"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ecomSkey"
      req: false
      type: "`$STRING`"
    }
    {
      format: "int32"
      name: "responseCode"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "responseMessage"
      req: false
      type: "`$STRING`"
    }
    {
      format: "int32"
      name: "terminalId"
      req: true
      type: "`$INTEGER`"
    }
  ]

  name: "ecom_parameter"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/public/getEcomParameters"
          segments: [
            {
              lit: "public"
            }
            {
              lit: "getEcomParameters"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
