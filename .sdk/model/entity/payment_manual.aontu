# Entity: payment_manual

main: kit: entity: payment_manual: {

  alias: field: {}

  fields: {
    acquirerName: {
      h: "Acquirer Name"
      n: "acquirerName"
      r: false
      sh: "Acquirer name parsed from KKG field"
      t: "`$STRING`"
    }
    amount: {
      fo: "int32"
      h: "Amount"
      n: "amount"
      r: true
      sh: "Transaction amount in minor units (cents)"
      t: "`$INTEGER`"
    }
    authorizationNumber: {
      h: "Authorization Number"
      n: "authorizationNumber"
      r: false
      sh: "Authorization number from the gateway"
      t: "`$STRING`"
    }
    cardNumber: {
      h: "Card Number"
      n: "cardNumber"
      r: true
      sh: "Card number - 12 to 19 digits, must pass Luhn validation"
      t: "`$STRING`"
    }
    cardType: {
      h: "Card Type"
      n: "cardType"
      r: false
      sh: "Card type parsed from KKG field"
      t: "`$STRING`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: true
      sh: "Currency code - 3 uppercase letters (ISO 4217)"
      t: "`$STRING`"
    }
    cvc: {
      h: "Cvc"
      n: "cvc"
      r: false
      sh: "Card verification code - 3-4 digits (optional)"
      t: "`$STRING`"
    }
    dateTimeTx: {
      h: "Date Time Tx"
      n: "dateTimeTx"
      r: false
      sh: "Date and time of the transaction"
      t: "`$STRING`"
    }
    expDate: {
      h: "Exp Date"
      n: "expDate"
      r: true
      sh: "Card expiry date in MMYY format"
      t: "`$STRING`"
    }
    merchantId: {
      h: "Merchant Id"
      n: "merchantId"
      r: false
      sh: "Merchant ID (VU-NUMMER)"
      t: "`$STRING`"
    }
    originalTransactionId: {
      h: "Original Transaction Id"
      n: "originalTransactionId"
      r: false
      sh: "Original transaction ID from gateway"
      t: "`$STRING`"
    }
    password: {
      h: "Password"
      n: "password"
      r: false
      sh: "Terminal password sent as Kennwort in TECS XML (optional)"
      t: "`$STRING`"
    }
    responseCode: {
      h: "Response Code"
      n: "responseCode"
      r: false
      sh: "Response code - 00 for success, otherwise error code"
      t: "`$STRING`"
    }
    responseMessage: {
      h: "Response Message"
      n: "responseMessage"
      r: false
      sh: "Response message - 'Approved' for success, error description otherwise"
      t: "`$STRING`"
    }
    terminalId: {
      h: "Terminal Id"
      n: "terminalId"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Terminal ID used for the transaction"
      t: "`$STRING`"
    }
    transactionId: {
      h: "Transaction Id"
      n: "transactionId"
      r: false
      sh: "Transaction ID generated by the backend"
      t: "`$STRING`"
    }
    txtype: {
      h: "Txtype"
      n: "txtype"
      r: true
      sh: "Transaction type"
      t: "`$STRING`"
    }
  }

  name: "payment_manual"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /public/paymentManual"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/public/paymentManual"
          s: [
            {
              lit: "public"
            }
            {
              lit: "paymentManual"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
