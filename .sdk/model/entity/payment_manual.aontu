  name: "payment_manual"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/public/paymentManual"
          parts: [
            "public"
            "paymentManual"
          ]
          transform: {
            req: "`reqdata`"
