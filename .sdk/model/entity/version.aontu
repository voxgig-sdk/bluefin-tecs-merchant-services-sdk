# Entity: version

main: kit: entity: version: {

  alias: field: {}

  fields: {
    appName: {
      h: "App Name"
      n: "appName"
      r: false
      t: "`$STRING`"
    }
    buildDate: {
      h: "Build Date"
      n: "buildDate"
      r: false
      t: "`$STRING`"
    }
    version: {
      h: "Version"
