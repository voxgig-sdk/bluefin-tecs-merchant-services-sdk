    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "mandator_clearing_export_download"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/public/digitalservices/mandatorClearingExportDownload"
          parts: [
            "public"
            "digitalservices"
