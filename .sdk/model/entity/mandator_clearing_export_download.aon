    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "responseCode"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "responseMessage"
      req: false
      type: "`$STRING`"
    }
    {
      name: "status"
